{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-isms.local/schemas/category.schema.json",
  "title": "Category",
  "description": "A logical group of related detection rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "label",
    "definition",
    "rules"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "rules/phrase-rule.schema.json"
          },
          {
            "$ref": "rules/regex-rule.schema.json"
          },
          {
            "$ref": "rules/structural-ratio-rule.schema.json"
          }
        ]
      }
    }
  }
}
